# routewire — RouterOS backend configuration
# Copy this file to .env and fill in your values.

# ── RouterOS backend (required) ─────────────────────────────────────────────

# IP, hostname, or full URL of the MikroTik device.
# Include the protocol to control HTTP vs HTTPS:
#   http://192.168.1.1    → plain HTTP (most home lab setups)
#   192.168.1.1           → defaults to HTTPS
#   https://router.local  → HTTPS
#
# Note: if RouterOS is not yet reachable on first boot (e.g. API user not
# created yet), leave this unset so the container can start and build the
# database without depending on RouterOS. Set it once RouterOS is ready.
ROUTEROS_HOST=http://192.168.1.1

# RouterOS API username (create a dedicated account with limited permissions)
ROUTEROS_USER=wireguard-api

# RouterOS API password
ROUTEROS_PASSWORD=changeme

# WireGuard interface name on RouterOS (must already exist or will be created)
ROUTEROS_INTERFACE=wg0

# Verify the RouterOS TLS certificate — only applies when using HTTPS.
# Most home lab setups use self-signed certs so this defaults to false.
ROUTEROS_VERIFY_SSL=false

# ── Web UI ───────────────────────────────────────────────────────────────────

PORT=51821
HOST=0.0.0.0
INSECURE=false
DISABLE_IPV6=false

# ── Initial setup (applied on first boot only) ───────────────────────────────

# INIT_ENABLED=true
# INIT_USERNAME=admin
# INIT_PASSWORD=changeme
# INIT_DNS=1.1.1.1,1.0.0.1
# INIT_IPV4_CIDR=10.8.0.0/24
# INIT_IPV6_CIDR=fd42:42:42::/64
# INIT_ALLOWED_IPS=0.0.0.0/0,::/0
# INIT_HOST=vpn.example.com
# INIT_PORT=51820
